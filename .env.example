# The backend always binds to 127.0.0.1. Point cloudflared at this port.
PORT=7681

# New tmux sessions start here. Use an absolute path.
WORKSPACE_DIR=/home/you

# Session used when the URL does not contain ?session=<name>.
DEFAULT_SESSION=main

# The Cloudflare Worker custom domain. Other browser origins are rejected.
PUBLIC_HOSTNAME=code.example.com

# Override these only if they are not discoverable from PATH.
TMUX_BIN=/usr/bin/tmux
TMUX_SOCKET=remote-code-agent

# Optional custom tmux config. The bundled config keeps detached sessions alive.
# TMUX_CONFIG=/absolute/path/to/tmux.conf
